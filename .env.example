# Telegram API (https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Telegram session string (generated by auth.py on first run)
TG_SESSION=

# Your Telegram user ID or username to receive notifications
# e.g. "me" for Saved Messages, or your username "@yourname"
TG_NOTIFY_TARGET=me

# Channels to monitor (comma-separated, include @)
# e.g. @channel1,@channel2,@channel3
TG_CHANNELS=@channel1,@channel2

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Minimum score (1-10) to trigger notification
MIN_SCORE=7
